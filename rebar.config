{erl_opts, [debug_info, warnings_as_errors, {parse_transform, lager_transform}]}.

{src_dirs, ["src",
            "src/core",
            "src/http",
            "src/exchange",
            "src/watch",
            "src/strategy",
            "src/account",
            "src/execution",
            "src/support",
            "src/diagnostics"]}.

{deps, [
    {lager, "3.9.2"},
    {gun, "2.1.0"},
    {observer_cli, "1.8.8"}
]}.

%% 打包（全局规则「Erlang 打包」）：在构建机上 rebar3 as prod tar，得到自带运行时的包，
%% 同系统（155 是 Rocky 8 / glibc 2.28）的机器解压即可运行，不依赖目标机安装 Erlang。
%% ERTS 和系统库取自构建机的 /rocky_erlang，构建机编译用的 OTP 也来自那里。
%% 顶层 relx 给本地开发用；不写 dev_mode：relx 默认就是开发模式，写了 {dev_mode, true}
%% 会盖掉 rebar3 as prod 自带的 prod 模式，包里的 beam 就不再剥离调试信息。
{relx, [
    {release, {arbiguard, "0.1.0"}, [arbiguard, observer_cli]},
    {include_src, false},
    {include_erts, "/rocky_erlang"},
    {system_libs, "/rocky_erlang/lib"},
    {extended_start_script, true},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"}
]}.

%% 部署包：配置没有环境变量占位，用成品 sys.config、vm.args（部署后在包内 releases/<版本>/ 下修改）。
{profiles, [
    {prod, [
        {relx, [
            {dev_mode, false},
            {sys_config, "config/sys.config"},
            {vm_args, "config/vm.args"}
        ]}
    ]}
]}.

{shell, [
    {apps, [arbiguard]},
    {config, "config/sys.config"}
]}.

{dist_node, [
    {name, 'arbiguard@127.0.0.1'},
    {setcookie, 'arbiguard_cookie'}
]}.
